//===========================================================================
//  my_osd.v  --  4-pixel parallel OSD
//
//  OSD layout for the 1280x720 camera image:
//    * the real blue/red Anlogic icon from the example at the top-left
//    * the current algorithm label directly below that icon
//    * the existing project's own "安路" banner at the bottom-left
//
//  Important: the bottom-left "安路" is deliberately the glyph/banner that
//  already belonged to this project (the 24x24 hand-written dot matrix), not
//  the Chinese characters from the example font library.  The example ROM is
//  used only for the blue/red icon.  A zero bit in the icon/font is
//  transparent, so the camera/processed pixel remains visible underneath.
//===========================================================================
module my_osd #(
    parameter IMG_WIDTH  = 1280,
    parameter IMG_HEIGHT = 720
)(
    input               I_clk,
    input               I_rst_n,
    input               I_tlast,
    input               I_tuser,
    input      [95:0]   I_tdata,
    input               I_tvalid,
    input               I_tready,
    output reg          O_tlast,
    output reg          O_tuser,
    output reg [95:0]   O_tdata,
    output reg          O_tvalid,
    output              O_tready,

    // Kept for interface compatibility with the existing ISP top.
    input      [1:0]    I_mode,
    input      [7:0]    I_luma_avg,
    input               I_osd_en
);

    // The block is a one-beat pipeline with no internal buffering.
    assign O_tready = I_tready;

    localparam [10:0] LOGO_W = 11'd160;
    localparam [10:0] LOGO_H = 11'd160;

    // The mode label is directly below the 160x160 logo.
    localparam [10:0] MODE_X = 11'd8;
    localparam [10:0] MODE_Y = 11'd168;
    localparam [10:0] MODE_W = 11'd160;
    localparam [10:0] MODE_H = 11'd24;

    // The bottom-left banner uses the existing project's original glyphs:
    // dark-blue 128x58 plaque with two 24x24 characters enlarged 2x.
    localparam [10:0] BRAND_X = 11'd16;
    localparam [10:0] BRAND_Y = IMG_HEIGHT - 11'd63;
    localparam [10:0] BRAND_W = 11'd128;
    localparam [10:0] BRAND_H = 11'd58;
    localparam [23:0] BRAND_BG = 24'h14203c;
    localparam [23:0] BRAND_FG = 24'hffe24a;

    localparam [23:0] TEXT_COLOR = 24'hfff200;

    // One stream beat contains pixels from left to right as follows:
    //   [95:72] pixel 0, [71:48] pixel 1, [47:24] pixel 2, [23:0] pixel 3.
    wire [23:0] I_pix0 = I_tdata[95:72];
    wire [23:0] I_pix1 = I_tdata[71:48];
    wire [23:0] I_pix2 = I_tdata[47:24];
    wire [23:0] I_pix3 = I_tdata[23:0];

    // x_grp is the group number within a line; y_pos is the active line.
    reg [8:0]  x_grp;
    reg [10:0] y_pos;
    wire [10:0] x_base = {x_grp, 2'b00};
    wire [10:0] x0 = x_base;
    wire [10:0] x1 = x_base + 11'd1;
    wire [10:0] x2 = x_base + 11'd2;
    wire [10:0] x3 = x_base + 11'd3;

    // ----------------------------------------------------------------------
    // Real 160x160 example logo ROM.  The ROM is sparse; bit[24] is the
    // valid/opaque flag and bits[23:0] are RGB888.
    // ----------------------------------------------------------------------
    wire logo_region0 = (x0 < LOGO_W) && (y_pos < LOGO_H);
    wire logo_region1 = (x1 < LOGO_W) && (y_pos < LOGO_H);
    wire logo_region2 = (x2 < LOGO_W) && (y_pos < LOGO_H);
    wire logo_region3 = (x3 < LOGO_W) && (y_pos < LOGO_H);

    wire [14:0] logo_addr0;
    wire [14:0] logo_addr1;
    wire [14:0] logo_addr2;
    wire [14:0] logo_addr3;

    // y*160 = y*128 + y*32.  The explicit zero extension prevents the
    // shift from being truncated to the 11-bit coordinate width.
    assign logo_addr0 = ({4'd0, y_pos} << 7) +
                        ({4'd0, y_pos} << 5) + {4'd0, x0};
    assign logo_addr1 = ({4'd0, y_pos} << 7) +
                        ({4'd0, y_pos} << 5) + {4'd0, x1};
    assign logo_addr2 = ({4'd0, y_pos} << 7) +
                        ({4'd0, y_pos} << 5) + {4'd0, x2};
    assign logo_addr3 = ({4'd0, y_pos} << 7) +
                        ({4'd0, y_pos} << 5) + {4'd0, x3};

    wire [24:0] logo_pixel0;
    wire [24:0] logo_pixel1;
    wire [24:0] logo_pixel2;
    wire [24:0] logo_pixel3;

    anlogic_logo_rom u_logo0 (
        .I_addr  (logo_addr0),
        .O_pixel (logo_pixel0)
    );
    anlogic_logo_rom u_logo1 (
        .I_addr  (logo_addr1),
        .O_pixel (logo_pixel1)
    );
    anlogic_logo_rom u_logo2 (
        .I_addr  (logo_addr2),
        .O_pixel (logo_pixel2)
    );
    anlogic_logo_rom u_logo3 (
        .I_addr  (logo_addr3),
        .O_pixel (logo_pixel3)
    );

    // ----------------------------------------------------------------------
    // Existing-project "安路" banner glyphs.
    // These two 24x24 dot matrices are copied from the project's original
    // OSD, then enlarged 2x exactly as that OSD did.
    // ----------------------------------------------------------------------
    function [23:0] project_rom_an;
        input [4:0] r;
        begin
            case (r)
                5'd0 : project_rom_an = 24'h003000;
                5'd1 : project_rom_an = 24'h003800;
                5'd2 : project_rom_an = 24'h001C00;
                5'd3 : project_rom_an = 24'h001000;
                5'd4 : project_rom_an = 24'h3FFFFC;
                5'd5 : project_rom_an = 24'h30000C;
                5'd6 : project_rom_an = 24'h30200C;
                5'd7 : project_rom_an = 24'h30700C;
                5'd8 : project_rom_an = 24'h006000;
                5'd9 : project_rom_an = 24'h00C000;
                5'd10: project_rom_an = 24'h00C000;
                5'd11: project_rom_an = 24'h7FFFFE;
                5'd12: project_rom_an = 24'h0180C0;
                5'd13: project_rom_an = 24'h0380C0;
                5'd14: project_rom_an = 24'h030180;
                5'd15: project_rom_an = 24'h078180;
                5'd16: project_rom_an = 24'h03F300;
                5'd17: project_rom_an = 24'h007E00;
                5'd18: project_rom_an = 24'h001F80;
                5'd19: project_rom_an = 24'h0079F0;
                5'd20: project_rom_an = 24'h01F07C;
                5'd21: project_rom_an = 24'h3FC01E;
                5'd22: project_rom_an = 24'h3E0004;
                5'd23: project_rom_an = 24'h000000;
                default: project_rom_an = 24'h000000;
            endcase
        end
    endfunction

    function [23:0] project_rom_lu;
        input [4:0] r;
        begin
            case (r)
                5'd0 : project_rom_lu = 24'h000300;
                5'd1 : project_rom_lu = 24'h000700;
                5'd2 : project_rom_lu = 24'h3FC600;
                5'd3 : project_rom_lu = 24'h30C7FC;
                5'd4 : project_rom_lu = 24'h30CC18;
                5'd5 : project_rom_lu = 24'h30DC18;
                5'd6 : project_rom_lu = 24'h30DE30;
                5'd7 : project_rom_lu = 24'h3FF330;
                5'd8 : project_rom_lu = 24'h3FC1E0;
                5'd9 : project_rom_lu = 24'h0600C0;
                5'd10: project_rom_lu = 24'h0601F0;
                5'd11: project_rom_lu = 24'h060F3C;
                5'd12: project_rom_lu = 24'h367C0F;
                5'd13: project_rom_lu = 24'h37D002;
                5'd14: project_rom_lu = 24'h360FF8;
                5'd15: project_rom_lu = 24'h360C08;
                5'd16: project_rom_lu = 24'h360C08;
                5'd17: project_rom_lu = 24'h360C08;
                5'd18: project_rom_lu = 24'h36EC08;
                5'd19: project_rom_lu = 24'h3FCC08;
                5'd20: project_rom_lu = 24'hFE0FF8;
                5'd21: project_rom_lu = 24'h700C08;
                5'd22: project_rom_lu = 24'h000C08;
                5'd23: project_rom_lu = 24'h000000;
                default: project_rom_lu = 24'h000000;
            endcase
        end
    endfunction

    function [23:0] project_brand_pixel;
        input [10:0] x;
        input [10:0] y;
        input [23:0] base;
        reg [10:0] lx;
        reg [10:0] ly;
        reg [10:0] cx;
        reg [4:0]  px;
        reg [4:0]  py;
        reg [23:0] word;
        begin
            project_brand_pixel = base;
            if ((x >= BRAND_X) && (x < (BRAND_X + BRAND_W)) &&
                (y >= BRAND_Y) && (y < (BRAND_Y + BRAND_H))) begin
                project_brand_pixel = BRAND_BG;
                if ((x >= (BRAND_X + 11'd16)) &&
                    (x <  (BRAND_X + 11'd112)) &&
                    (y >= (BRAND_Y + 11'd5)) &&
                    (y <  (BRAND_Y + 11'd53))) begin
                    lx = x - BRAND_X - 11'd16;
                    ly = y - BRAND_Y - 11'd5;
                    cx = (lx >= 11'd48) ? (lx - 11'd48) : lx;
                    px = cx[5:1];
                    py = ly[5:1];
                    word = (lx >= 11'd48) ? project_rom_lu(py) :
                                             project_rom_an(py);
                    if (word[5'd23 - px])
                        project_brand_pixel = BRAND_FG;
                end
            end
        end
    endfunction

    // ----------------------------------------------------------------------
    // Text layout helpers.
    //
    // The 16x16 glyphs are displayed in a 16x24 cell.  Chinese "安路" uses
    // a 24-pixel-wide cell, matching the example's enlarged glyphs.  The
    // mode label changes with I_mode:
    //   M0 SOBEL, M1 GRAY, M2 BINARY, M3 COLOR
    // ----------------------------------------------------------------------
    function [7:0] mode_char_at;
        input [10:0] x;
        input [1:0]  md;
        reg [10:0] dx;
        reg [3:0]  idx;
        begin
            mode_char_at = 8'h00;
            dx = 11'd0;
            idx = 4'd0;
            if ((x >= MODE_X) && (x < (MODE_X + MODE_W))) begin
                dx  = x - MODE_X;
                idx = dx >> 4;
                case (md)
                    2'd0: begin
                        case (idx)
                            4'd0: mode_char_at = 8'h4d; // M
                            4'd1: mode_char_at = 8'h30; // 0
                            4'd3: mode_char_at = 8'h53; // S
                            4'd4: mode_char_at = 8'h4f; // O
                            4'd5: mode_char_at = 8'h42; // B
                            4'd6: mode_char_at = 8'h45; // E
                            4'd7: mode_char_at = 8'h4c; // L
                            default: mode_char_at = 8'h00;
                        endcase
                    end
                    2'd1: begin
                        case (idx)
                            4'd0: mode_char_at = 8'h4d; // M
                            4'd1: mode_char_at = 8'h31; // 1
                            4'd3: mode_char_at = 8'h47; // G
                            4'd4: mode_char_at = 8'h52; // R
                            4'd5: mode_char_at = 8'h41; // A
                            4'd6: mode_char_at = 8'h59; // Y
                            default: mode_char_at = 8'h00;
                        endcase
                    end
                    2'd2: begin
                        case (idx)
                            4'd0: mode_char_at = 8'h4d; // M
                            4'd1: mode_char_at = 8'h32; // 2
                            4'd3: mode_char_at = 8'h42; // B
                            4'd4: mode_char_at = 8'h49; // I
                            4'd5: mode_char_at = 8'h4e; // N
                            4'd6: mode_char_at = 8'h41; // A
                            4'd7: mode_char_at = 8'h52; // R
                            4'd8: mode_char_at = 8'h59; // Y
                            default: mode_char_at = 8'h00;
                        endcase
                    end
                    default: begin
                        case (idx)
                            4'd0: mode_char_at = 8'h4d; // M
                            4'd1: mode_char_at = 8'h33; // 3
                            4'd3: mode_char_at = 8'h43; // C
                            4'd4: mode_char_at = 8'h4f; // O
                            4'd5: mode_char_at = 8'h4c; // L
                            4'd6: mode_char_at = 8'h4f; // O
                            4'd7: mode_char_at = 8'h52; // R
                            default: mode_char_at = 8'h00;
                        endcase
                    end
                endcase
            end
        end
    endfunction

    function [7:0] text_char_at;
        input [10:0] x;
        input [10:0] y;
        input [1:0]  md;
        begin
            text_char_at = 8'h00;
            if ((y >= MODE_Y) && (y < (MODE_Y + MODE_H)))
                text_char_at = mode_char_at(x, md);
        end
    endfunction

    function [3:0] text_row_at;
        input [10:0] y;
        reg [10:0] dy;
        begin
            text_row_at = 4'd0;
            dy = 11'd0;
            if ((y >= MODE_Y) && (y < (MODE_Y + MODE_H))) begin
                dy = y - MODE_Y;
                if (dy >= 11'd2)
                    text_row_at = ((dy - 11'd2) * 16) / 24;
            end
        end
    endfunction

    function [3:0] text_col_at;
        input [10:0] x;
        input [10:0] y;
        reg [10:0] dx;
        begin
            text_col_at = 4'd0;
            dx = 11'd0;
            if ((y >= MODE_Y) && (y < (MODE_Y + MODE_H)) &&
                (x >= MODE_X) && (x < (MODE_X + MODE_W))) begin
                dx = x - MODE_X;
                text_col_at = dx[3:0];
            end
        end
    endfunction

    function text_row_bit;
        input [15:0] row_bits;
        input [3:0]  col;
        begin
            case (col)
                4'd0:  text_row_bit = row_bits[15];
                4'd1:  text_row_bit = row_bits[14];
                4'd2:  text_row_bit = row_bits[13];
                4'd3:  text_row_bit = row_bits[12];
                4'd4:  text_row_bit = row_bits[11];
                4'd5:  text_row_bit = row_bits[10];
                4'd6:  text_row_bit = row_bits[9];
                4'd7:  text_row_bit = row_bits[8];
                4'd8:  text_row_bit = row_bits[7];
                4'd9:  text_row_bit = row_bits[6];
                4'd10: text_row_bit = row_bits[5];
                4'd11: text_row_bit = row_bits[4];
                4'd12: text_row_bit = row_bits[3];
                4'd13: text_row_bit = row_bits[2];
                4'd14: text_row_bit = row_bits[1];
                4'd15: text_row_bit = row_bits[0];
                default: text_row_bit = 1'b0;
            endcase
        end
    endfunction

    wire [7:0] text_char0 = text_char_at(x0, y_pos, I_mode);
    wire [7:0] text_char1 = text_char_at(x1, y_pos, I_mode);
    wire [7:0] text_char2 = text_char_at(x2, y_pos, I_mode);
    wire [7:0] text_char3 = text_char_at(x3, y_pos, I_mode);
    wire [3:0] text_row = text_row_at(y_pos);
    wire [3:0] text_col0 = text_col_at(x0, y_pos);
    wire [3:0] text_col1 = text_col_at(x1, y_pos);
    wire [3:0] text_col2 = text_col_at(x2, y_pos);
    wire [3:0] text_col3 = text_col_at(x3, y_pos);

    wire [15:0] text_bits0;
    wire [15:0] text_bits1;
    wire [15:0] text_bits2;
    wire [15:0] text_bits3;

    osd_char_lib u_char0 (
        .I_char     (text_char0),
        .I_row      (text_row),
        .O_row_bits (text_bits0)
    );
    osd_char_lib u_char1 (
        .I_char     (text_char1),
        .I_row      (text_row),
        .O_row_bits (text_bits1)
    );
    osd_char_lib u_char2 (
        .I_char     (text_char2),
        .I_row      (text_row),
        .O_row_bits (text_bits2)
    );
    osd_char_lib u_char3 (
        .I_char     (text_char3),
        .I_row      (text_row),
        .O_row_bits (text_bits3)
    );

    wire text_region0 =
        (x0 >= MODE_X) && (x0 < (MODE_X + MODE_W)) &&
        (y_pos >= MODE_Y) && (y_pos < (MODE_Y + MODE_H));
    wire text_region1 =
        (x1 >= MODE_X) && (x1 < (MODE_X + MODE_W)) &&
        (y_pos >= MODE_Y) && (y_pos < (MODE_Y + MODE_H));
    wire text_region2 =
        (x2 >= MODE_X) && (x2 < (MODE_X + MODE_W)) &&
        (y_pos >= MODE_Y) && (y_pos < (MODE_Y + MODE_H));
    wire text_region3 =
        (x3 >= MODE_X) && (x3 < (MODE_X + MODE_W)) &&
        (y_pos >= MODE_Y) && (y_pos < (MODE_Y + MODE_H));

    wire brand_region0 =
        (x0 >= BRAND_X) && (x0 < (BRAND_X + BRAND_W)) &&
        (y_pos >= BRAND_Y) && (y_pos < (BRAND_Y + BRAND_H));
    wire brand_region1 =
        (x1 >= BRAND_X) && (x1 < (BRAND_X + BRAND_W)) &&
        (y_pos >= BRAND_Y) && (y_pos < (BRAND_Y + BRAND_H));
    wire brand_region2 =
        (x2 >= BRAND_X) && (x2 < (BRAND_X + BRAND_W)) &&
        (y_pos >= BRAND_Y) && (y_pos < (BRAND_Y + BRAND_H));
    wire brand_region3 =
        (x3 >= BRAND_X) && (x3 < (BRAND_X + BRAND_W)) &&
        (y_pos >= BRAND_Y) && (y_pos < (BRAND_Y + BRAND_H));

    wire [23:0] brand_pix0 = project_brand_pixel(x0, y_pos, I_pix0);
    wire [23:0] brand_pix1 = project_brand_pixel(x1, y_pos, I_pix1);
    wire [23:0] brand_pix2 = project_brand_pixel(x2, y_pos, I_pix2);
    wire [23:0] brand_pix3 = project_brand_pixel(x3, y_pos, I_pix3);

    wire text_on0 = text_region0 && text_row_bit(text_bits0, text_col0);
    wire text_on1 = text_region1 && text_row_bit(text_bits1, text_col1);
    wire text_on2 = text_region2 && text_row_bit(text_bits2, text_col2);
    wire text_on3 = text_region3 && text_row_bit(text_bits3, text_col3);

    wire [23:0] O_pix0 = (I_osd_en && logo_region0 && logo_pixel0[24]) ?
                         logo_pixel0[23:0] :
                         ((I_osd_en && text_on0) ? TEXT_COLOR :
                          ((I_osd_en && brand_region0) ? brand_pix0 : I_pix0));
    wire [23:0] O_pix1 = (I_osd_en && logo_region1 && logo_pixel1[24]) ?
                         logo_pixel1[23:0] :
                         ((I_osd_en && text_on1) ? TEXT_COLOR :
                          ((I_osd_en && brand_region1) ? brand_pix1 : I_pix1));
    wire [23:0] O_pix2 = (I_osd_en && logo_region2 && logo_pixel2[24]) ?
                         logo_pixel2[23:0] :
                         ((I_osd_en && text_on2) ? TEXT_COLOR :
                          ((I_osd_en && brand_region2) ? brand_pix2 : I_pix2));
    wire [23:0] O_pix3 = (I_osd_en && logo_region3 && logo_pixel3[24]) ?
                         logo_pixel3[23:0] :
                         ((I_osd_en && text_on3) ? TEXT_COLOR :
                          ((I_osd_en && brand_region3) ? brand_pix3 : I_pix3));

    // One-cycle stream register.  The current design runs with continuous
    // ready, but the coordinate counters still advance only on a handshake.
    always @(posedge I_clk or negedge I_rst_n) begin
        if (!I_rst_n) begin
            O_tlast  <= 1'b0;
            O_tuser  <= 1'b0;
            O_tdata  <= 96'd0;
            O_tvalid <= 1'b0;
            x_grp    <= 9'd0;
            y_pos    <= 11'd0;
        end else begin
            O_tlast  <= I_tlast;
            O_tuser  <= I_tuser;
            O_tvalid <= I_tvalid;

            if (I_tvalid && I_tready)
                O_tdata <= {O_pix0, O_pix1, O_pix2, O_pix3};
            else if (!I_tvalid)
                O_tdata <= 96'd0;

            if (I_tvalid && I_tready) begin
                if (I_tuser) begin
                    // The first beat of a frame is x=0,y=0.
                    x_grp <= 9'd1;
                    y_pos <= 11'd0;
                end else if (I_tlast) begin
                    x_grp <= 9'd0;
                    y_pos <= (y_pos == (IMG_HEIGHT - 1)) ? 11'd0 :
                             (y_pos + 11'd1);
                end else begin
                    x_grp <= x_grp + 9'd1;
                end
            end
        end
    end

endmodule