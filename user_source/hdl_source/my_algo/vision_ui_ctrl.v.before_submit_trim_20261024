// Four-key UI controller for the local HDMI vision interface.
// K1/K2 navigate; K3 enters a page; K4 returns to the main menu.
// The eight menu entries match the eight requested extension items.
// UART transmission stays disabled.
module vision_ui_ctrl (
    input  wire       I_clk,
    input  wire       I_rst_n,
    input  wire       I_key_up,
    input  wire       I_key_down,
    input  wire       I_key_enter,
    input  wire       I_key_back,
    output reg  [1:0] O_mode,
    output reg  [3:0] O_page,
    output reg  [3:0] O_menu_index,
    output reg        O_in_menu,
    output reg        O_osd_en
);

    localparam [3:0] MENU_LAST = 4'd7;

    always @(posedge I_clk or negedge I_rst_n) begin
        if (!I_rst_n) begin
            O_mode      <= 2'd0;
            O_page      <= 4'd0;
            O_menu_index<= 4'd0;
            O_in_menu   <= 1'b1;
            O_osd_en    <= 1'b1;
        end else begin
            O_osd_en   <= 1'b1;

            if (O_in_menu) begin
                if (I_key_up) begin
                    if (O_menu_index == 4'd0)
                        O_menu_index <= MENU_LAST;
                    else
                        O_menu_index <= O_menu_index - 4'd1;
                end else if (I_key_down) begin
                    if (O_menu_index == MENU_LAST)
                        O_menu_index <= 4'd0;
                    else
                        O_menu_index <= O_menu_index + 4'd1;
                end

                if (I_key_enter) begin
                    O_page    <= O_menu_index;
                    O_in_menu <= 1'b0;
                end
            end else begin
                if (I_key_back) begin
                    O_in_menu <= 1'b1;
                end else if (O_page == 4'd0) begin
                    // Algorithm selection is only active inside the image-mode page.
                    if (I_key_up) begin
                        if (O_mode == 2'd0)
                            O_mode <= 2'd3;
                        else
                            O_mode <= O_mode - 2'd1;
                    end else if (I_key_down) begin
                        if (O_mode == 2'd3)
                            O_mode <= 2'd0;
                        else
                            O_mode <= O_mode + 2'd1;
                    end
                end
            end
        end
    end

endmodule
