                                         I_motion_y_min, I_motion_y_max);
    wire box_motion1 = !I_in_menu && I_motion_active && (I_page == 4'd3) &&
                       detect_box_border(x1, y_pos, I_motion_x_min, I_motion_x_max,
                                         I_motion_y_min, I_motion_y_max);
    wire box_motion2 = !I_in_menu && I_motion_active && (I_page == 4'd3) &&
                       detect_box_border(x2, y_pos, I_motion_x_min, I_motion_x_max,
                                         I_motion_y_min, I_motion_y_max);
    wire box_motion3 = !I_in_menu && I_motion_active && (I_page == 4'd3) &&
                       detect_box_border(x3, y_pos, I_motion_x_min, I_motion_x_max,
                                         I_motion_y_min, I_motion_y_max);
    wire [23:0] box_plate_color = 24'h00FFFF;
    wire [23:0] box_track_color = 24'hFF3030;
    wire [23:0] box_motion_color = 24'h40FF60;
    wire [3:0] panel_text_mask = {
        I_osd_en && (char3 != 8'h00) && !box_plate3 && !box_track3 && !box_motion3,
        I_osd_en && (char2 != 8'h00) && !box_plate2 && !box_track2 && !box_motion2,
        I_osd_en && (char1 != 8'h00) && !box_plate1 && !box_track1 && !box_motion1,
        I_osd_en && (char0 != 8'h00) && !box_plate0 && !box_track0 && !box_motion0
    };
    wire [3:0] menu_text_mask = {
        (menu_char3 != 8'h00) && !menu_logo3 && !menu_icon3,
        (menu_char2 != 8'h00) && !menu_logo2 && !menu_icon2,
        (menu_char1 != 8'h00) && !menu_logo1 && !menu_icon1,
        (menu_char0 != 8'h00) && !menu_logo0 && !menu_icon0
    };
    wire [23:0] panel_base0 = box_plate0 ? box_plate_color :
                              (box_track0 ? box_track_color :
                              (box_motion0 ? box_motion_color : bg0));
    wire [23:0] panel_base1 = box_plate1 ? box_plate_color :
                              (box_track1 ? box_track_color :
                              (box_motion1 ? box_motion_color : bg1));
    wire [23:0] panel_base2 = box_plate2 ? box_plate_color :
                              (box_track2 ? box_track_color :
                              (box_motion2 ? box_motion_color : bg2));
    wire [23:0] panel_base3 = box_plate3 ? box_plate_color :
                              (box_track3 ? box_track_color :
                              (box_motion3 ? box_motion_color : bg3));
    wire [23:0] panel_text_color = selected_line0 ? SELECT_COLOR : TEXT_COLOR;

    reg        pipe_tlast;
    reg        pipe_tuser;
    reg        pipe_in_menu;
    reg [95:0] pipe_panel_base;
    reg [95:0] pipe_menu_base;
    reg [3:0]  pipe_panel_text_mask;
    reg [3:0]  pipe_menu_text_mask;
    reg [23:0] pipe_panel_text_color;
    reg [95:0] pipe_menu_text_colors;
    reg [31:0] pipe_font_chars;
    reg [15:0] pipe_font_cols;

    wire [7:0] pipe_char0 = pipe_font_chars[31:24];
    wire [7:0] pipe_char1 = pipe_font_chars[23:16];
    wire [7:0] pipe_char2 = pipe_font_chars[15:8];
    wire [7:0] pipe_char3 = pipe_font_chars[7:0];
    wire [3:0] pipe_col0 = pipe_font_cols[15:12];
    wire [3:0] pipe_col1 = pipe_font_cols[11:8];
    wire [3:0] pipe_col2 = pipe_font_cols[7:4];
    wire [3:0] pipe_col3 = pipe_font_cols[3:0];
    wire font_bit0 = font_bits_a[4'd15 - pipe_col0];
    wire font_bit1 = (pipe_char1 == pipe_char0) ? font_bits_a[4'd15 - pipe_col1] :
                     (pipe_char1 == pipe_char3) ? font_bits_b[4'd15 - pipe_col1] : 1'b0;
    wire font_bit2 = (pipe_char2 == pipe_char0) ? font_bits_a[4'd15 - pipe_col2] :
                     (pipe_char2 == pipe_char3) ? font_bits_b[4'd15 - pipe_col2] : 1'b0;
    wire font_bit3 = font_bits_b[4'd15 - pipe_col3];

    wire [23:0] out_pix0 = pipe_in_menu ?
        ((pipe_menu_text_mask[0] && font_bit0) ? pipe_menu_text_colors[95:72] : pipe_menu_base[95:72]) :
        ((pipe_panel_text_mask[0] && font_bit0) ? pipe_panel_text_color : pipe_panel_base[95:72]);
    wire [23:0] out_pix1 = pipe_in_menu ?
        ((pipe_menu_text_mask[1] && font_bit1) ? pipe_menu_text_colors[71:48] : pipe_menu_base[71:48]) :
        ((pipe_panel_text_mask[1] && font_bit1) ? pipe_panel_text_color : pipe_panel_base[71:48]);
    wire [23:0] out_pix2 = pipe_in_menu ?
        ((pipe_menu_text_mask[2] && font_bit2) ? pipe_menu_text_colors[47:24] : pipe_menu_base[47:24]) :
        ((pipe_panel_text_mask[2] && font_bit2) ? pipe_panel_text_color : pipe_panel_base[47:24]);
    wire [23:0] out_pix3 = pipe_in_menu ?
        ((pipe_menu_text_mask[3] && font_bit3) ? pipe_menu_text_colors[23:0] : pipe_menu_base[23:0]) :
        ((pipe_panel_text_mask[3] && font_bit3) ? pipe_panel_text_color : pipe_panel_base[23:0]);

    assign O_tready = !pipe_valid || I_tready;
    assign O_tvalid = pipe_valid;
    assign O_tlast = pipe_tlast;
    assign O_tuser = pipe_tuser;
    assign O_tdata = pipe_valid ? {out_pix0, out_pix1, out_pix2, out_pix3} : 96'd0;

    always @(posedge I_clk or negedge I_rst_n) begin
        if (!I_rst_n) begin
            pipe_valid          <= 1'b0;
            pipe_tlast          <= 1'b0;
            pipe_tuser          <= 1'b0;
            pipe_in_menu        <= 1'b0;
            pipe_panel_base     <= 96'd0;
            pipe_menu_base      <= 96'd0;
            pipe_panel_text_mask <= 4'd0;
            pipe_menu_text_mask <= 4'd0;
            pipe_panel_text_color <= 24'd0;
            pipe_menu_text_colors <= 96'd0;
            pipe_font_chars     <= 32'd0;
            pipe_font_cols      <= 16'd0;
            x_grp               <= 9'd0;
            y_pos               <= 11'd0;
        end else if (O_tready) begin
            pipe_valid <= I_tvalid;
            if (I_tvalid) begin
                pipe_tlast           <= I_tlast;
                pipe_tuser           <= I_tuser;
                pipe_in_menu         <= I_in_menu;
                pipe_panel_base      <= {panel_base0, panel_base1, panel_base2, panel_base3};
                pipe_menu_base       <= {menu_base0, menu_base1, menu_base2, menu_base3};
                pipe_panel_text_mask <= panel_text_mask;
                pipe_menu_text_mask  <= menu_text_mask;
                pipe_panel_text_color <= panel_text_color;
                pipe_menu_text_colors <= {menu_text_color0, menu_text_color1,
                                          menu_text_color2, menu_text_color3};
                pipe_font_chars      <= {font_char0, font_char1, font_char2, font_char3};
                pipe_font_cols       <= {font_col0, font_col1, font_col2, font_col3};

                if (input_accept && I_tuser) begin
                    x_grp <= 9'd1;
                    y_pos <= 11'd0;
                end else if (input_accept && I_tlast) begin
                    x_grp <= 9'd0;
                    y_pos <= (y_pos == (IMG_HEIGHT - 1)) ? 11'd0 : y_pos + 11'd1;
                end else if (input_accept) begin
                    x_grp <= x_grp + 9'd1;
                end
            end
        end
    end

endmodule

module osd_char_rom_dp (
    input  wire        I_clk,
    input  wire        I_en,
    input  wire [7:0]  I_char_a,
    input  wire [7:0]  I_char_b,
    input  wire [3:0]  I_row,
    output reg  [15:0] O_bits_a,
    output reg  [15:0] O_bits_b
);
    function [7:0] glyph_index;
        input [7:0] code;
        begin
            if ((code >= 8'h80) && (code <= 8'hFF))
                glyph_index = code - 8'h7F;
            else begin
                case (code)
                    8'h1C: glyph_index = 8'd129;
                    8'h1D: glyph_index = 8'd130;
                    8'h1E: glyph_index = 8'd131;
                    8'h1F: glyph_index = 8'd132;
                    8'h30: glyph_index = 8'd133;
                    8'h31: glyph_index = 8'd134;
                    8'h32: glyph_index = 8'd135;
                    8'h33: glyph_index = 8'd136;
                    8'h34: glyph_index = 8'd137;
                    8'h35: glyph_index = 8'd138;
                    8'h36: glyph_index = 8'd139;
                    8'h37: glyph_index = 8'd140;
                    8'h38: glyph_index = 8'd141;
                    8'h39: glyph_index = 8'd142;
                    8'h41: glyph_index = 8'd143;
                    8'h42: glyph_index = 8'd144;
                    8'h43: glyph_index = 8'd145;
                    8'h44: glyph_index = 8'd146;
                    8'h45: glyph_index = 8'd147;
                    8'h46: glyph_index = 8'd148;
                    8'h47: glyph_index = 8'd149;
                    8'h48: glyph_index = 8'd150;
                    8'h49: glyph_index = 8'd151;
                    8'h4A: glyph_index = 8'd152;
                    8'h4B: glyph_index = 8'd153;
                    8'h4C: glyph_index = 8'd154;
                    8'h4D: glyph_index = 8'd155;
                    8'h4E: glyph_index = 8'd156;
                    8'h4F: glyph_index = 8'd157;
                    8'h50: glyph_index = 8'd158;
                    8'h51: glyph_index = 8'd159;
                    8'h52: glyph_index = 8'd160;
                    8'h53: glyph_index = 8'd161;
                    8'h54: glyph_index = 8'd162;
                    8'h55: glyph_index = 8'd163;
                    8'h56: glyph_index = 8'd164;
                    8'h57: glyph_index = 8'd165;
                    8'h58: glyph_index = 8'd166;
                    8'h59: glyph_index = 8'd167;
                    8'h5A: glyph_index = 8'd168;
                    8'h3A: glyph_index = 8'd169;
                    8'h64: glyph_index = 8'd170;
                    8'h65: glyph_index = 8'd171;
                    8'h6C: glyph_index = 8'd172;
                    8'h6F: glyph_index = 8'd173;
                    default: glyph_index = 8'd0;
                endcase
            end
        end
    endfunction

    /* fehdl force_ram=1, ram_style="bram_fast" */
    reg [15:0] glyph_mem [0:2783];
    initial $readmemh("../../../user_source/hdl_source/my_algo/rom_init/osd_font.mem", glyph_mem);

    always @(posedge I_clk) begin
        if (I_en) begin
            O_bits_a <= glyph_mem[{glyph_index(I_char_a), I_row}];
            O_bits_b <= glyph_mem[{glyph_index(I_char_b), I_row}];
        end
    end
endmodule
