    function [23:0] ui_background;
        input [10:0] x;
        input [10:0] y;
        input [23:0] base;
        input [3:0]  menu_index;
        input        in_menu;
        reg [4:0] line;
        reg [7:0] mix_r;
        reg [7:0] mix_g;
        reg [7:0] mix_b;
        begin
            ui_background = base;
            mix_r = 8'd0;
            mix_g = 8'd0;
            mix_b = 8'd0;
            line = (y >= PANEL_Y) ? ((y - PANEL_Y) / 11'd12) : 5'd0;
            if ((x >= PANEL_X) && (x < (PANEL_X + PANEL_W)) &&
                (y >= PANEL_Y) && (y < (PANEL_Y + PANEL_H))) begin
                mix_r = {1'b0, base[23:17]} + {1'b0, PANEL_BG[23:17]};
                mix_g = {1'b0, base[15:9]}  + {1'b0, PANEL_BG[15:9]};
                mix_b = {1'b0, base[7:1]}   + {1'b0, PANEL_BG[7:1]};
                ui_background = {mix_r, mix_g, mix_b};
                if ((x < (PANEL_X + 11'd1)) ||
                    (x >= (PANEL_X + PANEL_W - 11'd1)) ||
                    (y < (PANEL_Y + 11'd1)) ||
                    (y >= (PANEL_Y + PANEL_H - 11'd1)))
                    ui_background = BORDER_COLOR;
                if (in_menu && (line >= 5'd5) && (line <= 5'd13) &&
                    ((line - 5'd5) == menu_index))
                    ui_background = 24'h16466A;
            end
        end
    endfunction

