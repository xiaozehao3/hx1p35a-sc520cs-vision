    wire [23:0] menu_pix0 = menu_logo0 ? menu_logo_color(x0, y_pos) :
                           (menu_icon0 ? menu_icon_color(menu_item0, x0, y_pos) :
                           (menu_text0 ? menu_text_color(y_pos, menu_item0, I_menu_index) : menu_bg0));
    wire [23:0] menu_pix1 = menu_logo1 ? menu_logo_color(x1, y_pos) :
