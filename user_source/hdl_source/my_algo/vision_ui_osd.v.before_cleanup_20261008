    wire [15:0] bits0;
    wire [15:0] bits1;
    wire [15:0] bits2;
    wire [15:0] bits3;
    osd_char_lib u_ui_char0(.I_char(char0), .I_row(y_pos[3:0]), .O_row_bits(bits0));
    osd_char_lib u_ui_char1(.I_char(char1), .I_row(y_pos[3:0]), .O_row_bits(bits1));
    osd_char_lib u_ui_char2(.I_char(char2), .I_row(y_pos[3:0]), .O_row_bits(bits2));
    osd_char_lib u_ui_char3(.I_char(char3), .I_row(y_pos[3:0]), .O_row_bits(bits3));

    wire [23:0] bg0 = ui_background(x0, y_pos, I_pix0, I_menu_index, I_in_menu);
    wire [23:0] bg1 = ui_background(x1, y_pos, I_pix1, I_menu_index, I_in_menu);
    wire [23:0] bg2 = ui_background(x2, y_pos, I_pix2, I_menu_index, I_in_menu);
    wire [23:0] bg3 = ui_background(x3, y_pos, I_pix3, I_menu_index, I_in_menu);
    wire text0 = (char0 != 8'h00) && bits0[4'd15 - x0[3:0]];
    wire text1 = (char1 != 8'h00) && bits1[4'd15 - x1[3:0]];
    wire text2 = (char2 != 8'h00) && bits2[4'd15 - x2[3:0]];
    wire text3 = (char3 != 8'h00) && bits3[4'd15 - x3[3:0]];

    wire [3:0] menu_item0 = menu_item_at(x0, y_pos);
    wire [3:0] menu_item1 = menu_item_at(x1, y_pos);
    wire [3:0] menu_item2 = menu_item_at(x2, y_pos);
    wire [3:0] menu_item3 = menu_item_at(x3, y_pos);
    wire [7:0] menu_char0 = menu_char_at(x0, y_pos);
    wire [7:0] menu_char1 = menu_char_at(x1, y_pos);
    wire [7:0] menu_char2 = menu_char_at(x2, y_pos);
    wire [7:0] menu_char3 = menu_char_at(x3, y_pos);
    wire [3:0] menu_row = menu_text_row(y_pos);
    wire [3:0] menu_col0 = menu_text_col(x0, y_pos);
    wire [3:0] menu_col1 = menu_text_col(x1, y_pos);
    wire [3:0] menu_col2 = menu_text_col(x2, y_pos);
    wire [3:0] menu_col3 = menu_text_col(x3, y_pos);
    wire [15:0] menu_bits0;
    wire [15:0] menu_bits1;
    wire [15:0] menu_bits2;
    wire [15:0] menu_bits3;
    osd_char_lib u_menu_char0(.I_char(menu_char0), .I_row(menu_row), .O_row_bits(menu_bits0));
    osd_char_lib u_menu_char1(.I_char(menu_char1), .I_row(menu_row), .O_row_bits(menu_bits1));
    osd_char_lib u_menu_char2(.I_char(menu_char2), .I_row(menu_row), .O_row_bits(menu_bits2));
    osd_char_lib u_menu_char3(.I_char(menu_char3), .I_row(menu_row), .O_row_bits(menu_bits3));
    wire menu_text0 = (menu_char0 != 8'h00) && menu_bits0[4'd15 - menu_col0];
    wire menu_text1 = (menu_char1 != 8'h00) && menu_bits1[4'd15 - menu_col1];
    wire menu_text2 = (menu_char2 != 8'h00) && menu_bits2[4'd15 - menu_col2];
    wire menu_text3 = (menu_char3 != 8'h00) && menu_bits3[4'd15 - menu_col3];
    wire menu_logo0 = menu_logo_on(x0, y_pos);
    wire menu_logo1 = menu_logo_on(x1, y_pos);
    wire menu_logo2 = menu_logo_on(x2, y_pos);
