                            5'd3:ui_char_at=8'h55;5'd4:ui_char_at=8'h50;5'd5:ui_char_at=8'h20;
                            5'd6:ui_char_at=8'h4B;5'd7:ui_char_at=8'h32;5'd8:ui_char_at=8'h20;
                            5'd9:ui_char_at=8'h44;5'd10:ui_char_at=8'h4F;5'd11:ui_char_at=8'h57;
                            5'd12:ui_char_at=8'h4E;default:ui_char_at=8'h00;
                        endcase
                    end
                    5'd15: begin
                        case(char_cell)
                            5'd0:ui_char_at=8'h4B;5'd1:ui_char_at=8'h33;5'd2:ui_char_at=8'h20;
                            5'd3:ui_char_at=8'h4F;5'd4:ui_char_at=8'h4B;5'd5:ui_char_at=8'h20;
                            5'd6:ui_char_at=8'h4B;5'd7:ui_char_at=8'h34;5'd8:ui_char_at=8'h20;
                            5'd9:ui_char_at=8'h42;5'd10:ui_char_at=8'h41;5'd11:ui_char_at=8'h43;
                            5'd12:ui_char_at=8'h4B;default:ui_char_at=8'h00;
                        endcase
                    end
                    default:ui_char_at=8'h00;
                endcase
            end
        end
    endfunction

    function [23:0] ui_background;
        input [10:0] x;
        input [10:0] y;
        input [23:0] base;
        input [3:0]  menu_index;
        input        in_menu;
        reg [4:0] line;
        begin
            ui_background = base;
            line = y >> 4;
            if ((x >= PANEL_X) && (x < (PANEL_X + PANEL_W)) &&
                (y >= PANEL_Y) && (y < (PANEL_Y + PANEL_H))) begin
                ui_background = PANEL_BG;
                if ((x >= PANEL_X) && (x < (PANEL_X + PANEL_W)) &&
                    (y < 11'd2 || y >= (PANEL_H - 11'd2)))
                    ui_background = BORDER_COLOR;
                if (in_menu && (line >= 5'd5) && (line <= 5'd13) &&
                    ((line - 5'd5) == menu_index))
                    ui_background = 24'h16466A;
            end
        end
    endfunction

    function detect_box_border;
        input [10:0] x;
        input [10:0] y;
        input [10:0] x_min;
        input [10:0] x_max;
        input [10:0] y_min;
        input [10:0] y_max;
        begin
            detect_box_border = 1'b0;
            if ((x >= x_min) && (x <= x_max) &&
                (y >= y_min) && (y <= y_max)) begin
                detect_box_border =
                    ((x <= x_min + 11'd2) || (x + 11'd2 >= x_max) ||
                     (y <= y_min + 11'd2) || (y + 11'd2 >= y_max));
            end
        end
    endfunction

    wire [7:0] char0 = ui_char_at(x0, y_pos, I_mode, I_page, I_menu_index,
                                   I_in_menu, I_fps, I_capture_frame,
