    wire selected_line0 = I_in_menu && ((y_pos >> 4) >= 5'd5) &&
                          ((y_pos >> 4) <= 5'd13) &&
                          (((y_pos >> 4) - 5'd5) == I_menu_index);
    wire box_plate0 = !I_in_menu && I_plate_valid && (I_page == 4'd1) &&
                      detect_box_border(x0, y_pos, I_plate_x_min, I_plate_x_max,
                                        I_plate_y_min, I_plate_y_max);
    wire box_plate1 = !I_in_menu && I_plate_valid && (I_page == 4'd1) &&
                      detect_box_border(x1, y_pos, I_plate_x_min, I_plate_x_max,
                                        I_plate_y_min, I_plate_y_max);
    wire box_plate2 = !I_in_menu && I_plate_valid && (I_page == 4'd1) &&
                      detect_box_border(x2, y_pos, I_plate_x_min, I_plate_x_max,
