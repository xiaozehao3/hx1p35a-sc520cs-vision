    wire [23:0] pix3 = I_in_menu ? menu_pix3 : panel_pix3;

    always @(posedge I_clk or negedge I_rst_n) begin
        if (!I_rst_n) begin
            O_tlast  <= 1'b0;
            O_tuser  <= 1'b0;
            O_tdata  <= 96'd0;
            O_tvalid <= 1'b0;
            x_grp    <= 9'd0;
            y_pos    <= 11'd0;
        end else begin
            O_tlast  <= I_tlast;
            O_tuser  <= I_tuser;
            O_tvalid <= I_tvalid;

            if (I_tvalid && I_tready)
                O_tdata <= {pix0, pix1, pix2, pix3};
            else if (!I_tvalid)
                O_tdata <= 96'd0;

            if (I_tvalid && I_tready) begin
                if (I_tuser) begin
                    x_grp <= 9'd1;
                    y_pos <= 11'd0;
                end else if (I_tlast) begin
                    x_grp <= 9'd0;
                    y_pos <= (y_pos == (IMG_HEIGHT - 1)) ? 11'd0 : y_pos + 11'd1;
                end else begin
                    x_grp <= x_grp + 9'd1;
                end
            end
        end
